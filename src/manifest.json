{
  "manifest_version": 3,
  "name": "SwissKnife",
  "version": "0.1.1",
  "description": "A pocket multitool for your browser: a growing set of small, unrelated tweaks that make everyday sites a bit nicer.",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "action": {
    "default_title": "SwissKnife",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon.svg",
      "32": "icons/icon.svg"
    }
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["shared/settings.js", "content/watch-setting.js", "content/youtube.js"],
      "css": ["content/youtube.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://chatgpt.com/*", "*://chat.openai.com/*"],
      "js": ["shared/settings.js", "content/watch-setting.js", "content/chatgpt.js"],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "swissknife@zlskey",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
